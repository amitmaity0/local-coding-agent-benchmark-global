+def test_steps_propagation_through_optimization():
+    """OptimizationResult.new_steps propagates through the full chain.
+
+    Iteration 1: steps=30
+    → optimizer returns new_steps=45
+    → _apply_optimization_result updates Experiment.steps=45
+    → Iteration 2: generate uses steps=45
+    """
+    config = _make_config()
+    engine = Engine(config)
+    exp_id = _setup_experiment(
+        engine,
+        target_score=0.95,
+        max_iterations=5,
+        steps=30,
+    )
+
+    # Verify initial steps=30
+    status = engine.get_status(exp_id)
+    assert status.steps == 30
+
+    def mock_generate(*args, **kwargs):
+        it_num = kwargs.get("iteration", args[1] if len(args) > 1 else 1)
+        out_dir = Path(config.experiments_dir) / exp_id / f"iteration_{it_num:03d}"
+        out_dir.mkdir(parents=True, exist_ok=True)
+        video_path = out_dir / "output.mp4"
+        video_path.write_bytes(b"fake")
+        with get_session() as session:
+            it = (
+                session.query(IterationORM)
+                .filter_by(experiment_id=exp_id, number=it_num)
+                .first()
+            )
+            if not it:
+                it = IterationORM(
+                    experiment_id=exp_id,
+                    number=it_num,
+                    status="completed",
+                    output_path=str(video_path),
+                    created_at=datetime.now(timezone.utc),
+                )
+                session.add(it)
+            else:
+                it.output_path = str(video_path)
+                it.status = "completed"
+            session.flush()
+        return {"output_files": [str(video_path)], "success": True}
+
+    def mock_analyze_with_sampling(*args, **kwargs):
+        report = _mock_qa_report(score=0.75)
+        it_num = kwargs.get("iteration", args[1] if len(args) > 1 else 1)
+        with get_session() as session:
+            it = (
+                session.query(IterationORM)
+                .filter_by(experiment_id=exp_id, number=it_num)
+                .first()
+            )
+            if it:
+                report_dir = (
+                    Path(config.experiments_dir)
+                    / exp_id
+                    / f"iteration_{it_num:03d}"
+                )
+                report_dir.mkdir(parents=True, exist_ok=True)
+                qa_path = report_dir / "qa_report.json"
+                qa_path.write_text(json.dumps(report.model_dump(mode="json")))
+                it.report_path = str(qa_path)
+                it.score = report.overall_score
+                session.flush()
+        return report
+
+    # First optimization returns new_steps=45, subsequent calls keep steps=45
+    call_count = {"opt": 0}
+
+    def mock_optimize(*args, **kwargs):
+        call_count["opt"] += 1
+        if call_count["opt"] == 1:
+            return _mock_opt_result(new_steps=45)
+        # Keep steps=45 for subsequent iterations
+        return _mock_opt_result(new_seed=100, new_steps=45)
+
+    engine.generate = mock_generate  # type: ignore[method-assign]
+    engine.analyze_with_sampling = mock_analyze_with_sampling  # type: ignore[method-assign]
+    engine.optimize = mock_optimize  # type: ignore[method-assign]
+
+    engine.run_loop(exp_id)
+
+    # After first optimization, experiment steps should be 45
+    status = engine.get_status(exp_id)
+    assert status.steps == 45
