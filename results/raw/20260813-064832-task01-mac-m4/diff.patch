+    # Without sidecar, should fall back to KSampler (which doesn't exist in LTX)
+    result_no_sidecar = loader.set_steps(wf, 45)
+    # Fallback via _replace_by_class finds no KSampler, returns copy unchanged
+    assert result_no_sidecar["206"]["inputs"]["steps"] != 45
+
+
+def test_set_steps_unsupported_sidecar() -> None:
+    """Steps marked as unsupported should not modify the workflow."""
+    loader = WorkflowLoader(workflows_dir="workflows")
+    wf, sc = loader._load_with_sidecar("LTX2.3-Basic-API.json")
+    assert sc is not None
+
+    # Create a sidecar with steps marked as unsupported
+    from services.workflow import _Sidecar, _SidecarMapping
+
+    # _Sidecar takes (data_dict, workflow_name, workflow_dict)
+    unsupported_sc = _Sidecar(
+        data={
+            "version": 1,
+            "workflow": "LTX2.3-Basic-API.json",
+            "parameters": {
+                "prompt": {"node_id": "121", "input": "text"},
+                "negative_prompt": {"node_id": "110", "input": "text"},
+                "seed": {"nodes": [{"node_id": "114", "input": "noise_seed"}]},
+                "cfg": {"nodes": [{"node_id": "103", "input": "cfg"}]},
+                "noise": {"supported": False},
+                "steps": {"supported": False},
+            },
+        },
+        actual_workflow_name="LTX2.3-Basic-API.json",
+        workflow=wf,
+    )
+
+    original_steps = wf["206"]["inputs"]["steps"]
+    result = loader.set_steps(wf, 99, sidecar=unsupported_sc)
+    # Steps should remain unchanged when unsupported
+    assert result["206"]["inputs"]["steps"] == original_steps
+
